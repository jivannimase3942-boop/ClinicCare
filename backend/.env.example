# ClinicCare - Master Environment Configuration Template
# All secrets must be provided securely in your environment or production .env

# 1. Server Configuration
PROJECT_NAME="ClinicCare"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://localhost:8000", "https://cliniccare-g3c6.onrender.com"]

# 2. Security & JWT Authentication
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTOMATED_WORKFLOW_KEY="replace-with-a-long-random-workflow-key"

# 3. Database & Supabase Integration
DATABASE_URL="sqlite:///./hospital.db"
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. AI Provider Configuration (Google Gemini / OpenAI)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""

# 5. Meta WhatsApp Cloud API
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_VERIFY_TOKEN="replace-with-a-random-webhook-verification-token"
WA_API_VERSION="v19.0"

# 6. AI Voice Calling Integration (ElevenLabs / Retell / Bland / Twilio)
VOICE_API_URL=""
VOICE_API_KEY=""
VOICE_AGENT_ID=""

# 7. Email & Alerting (SMTP / Postmark / SendGrid)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER="alerts@cliniccarehospital.com"
ALERT_EMAIL_TO="admin@cliniccarehospital.com"

# 8. Hospital Profile & Defaults
HOSPITAL_NAME="ClinicCare Multispeciality Hospital"
HOSPITAL_PHONE="+1 (800) 555-0199"
HOSPITAL_EMAIL="care@cliniccarehospital.com"
HOSPITAL_ADDRESS="100 Healthcare Boulevard, Suite 400, Medical District"
EMERGENCY_HOTLINE="911 / 112"

# 9. n8n Automation Engine
N8N_HOST="localhost"
N8N_PORT=5678
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD=""

